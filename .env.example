# Copy to .env for local development and replace all placeholders.
SECRET_KEY=replace-with-random-secret
JWT_SECRET_KEY=replace-with-another-random-secret
BALLOT_KEY=replace-with-a-base64-encoded-32-byte-key
RESULT_SIGNING_KEY=replace-with-result-signing-key
WINDOW_CLOSE=2099-01-01T00:00:00
REQUIRE_HTTPS=false
MISSION_ALLOWLIST=
MISSION_CERTS=
RATELIMIT_ENABLED=false
RATELIMIT_STORAGE_URI=memory://
